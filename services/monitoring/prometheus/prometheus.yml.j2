global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node-exporter
    static_configs:
      - targets: ['node-exporter:9100']

  - job_name: cadvisor
    static_configs:
      - targets: ['cadvisor:8080']

  - job_name: loki
    static_configs:
      - targets: ['loki:3100']

  - job_name: traefik
    static_configs:
      - targets: ['traefik:8082']

  - job_name: tempo
    static_configs:
      - targets: ['tempo:3200']

  - job_name: keycloak
    static_configs:
      - targets: ['keycloak:9000']

  # The feed engine has no Traefik route, so Prometheus reaches it by container name
  # over the shared proxy network. It answers /metrics only for the source networks in
  # its METRICS_ALLOWED_NETWORKS, which the library role reads from that network.
  - job_name: library-miniflux
    static_configs:
      - targets: ['library-miniflux:8080']
